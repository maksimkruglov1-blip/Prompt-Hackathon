DATABASE_URL=postgres://controlroom:controlroom@localhost:5438/controlroom
S3_ENDPOINT=http://127.0.0.1:9009
S3_ACCESS_KEY_ID=controlroom
S3_SECRET_ACCESS_KEY=controlroom-local-only
S3_BUCKET=controlroom-attachments

# Optional LLM for the on-the-road agent (OpenAI-compatible).
# Without OPENAI_API_KEY the mock path runs. Never commit real keys.
#
# OpenRouter example:
# OPENAI_API_KEY=          # OpenRouter or OpenAI key — never commit
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=openai/gpt-4o-mini
# OPENROUTER_HTTP_REFERER=http://127.0.0.1:43123
# OPENROUTER_X_TITLE=Bahn Control Room
#
# Direct OpenAI example:
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
